{
  "name": "042tailoring-admin",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "vars": {
    "GITHUB_OWNER": "progen-ai-kr",
    "GITHUB_REPO": "042tailoring-aiai",
    "GITHUB_REPOS": "042tailoring-aiai,042tailoring-rgb",
    "GITHUB_BRANCH": "main",
    "ADMIN_ENABLED": "true",
    "ADMIN_STANDALONE": "true",
    "ADMIN_URL": "https://042tailoring-admin.progen-web.workers.dev/admin",
    "PUBLIC_SITE_URL": "https://042tailoring-aiai.progen-web.workers.dev"
  }
}
